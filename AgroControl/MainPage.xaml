<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AgroControl.MainPage"
    BackgroundColor="#101812">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="10">

            <Image
                Source="sunflower.png"
                HeightRequest="76"
                WidthRequest="76"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                Text="AgroControl"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#E4F0E5"
                HorizontalOptions="Center" />

            <Label
                Text="Умный уход за растениями"
                FontSize="13"
                TextColor="#9AAA9B"
                HorizontalOptions="Center" />

            <!-- Статус системы -->
            <Border
                BackgroundColor="#203326"
                Stroke="#304A36"
                StrokeShape="RoundRectangle 10"
                Padding="10">

                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        WidthRequest="8"
                        HeightRequest="8"
                        Fill="#65C879"
                        VerticalOptions="Center" />

                    <Label
                        Text="Система готова"
                        FontSize="13"
                        TextColor="#B9E6BF"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Label
                Text="Показатели"
                FontSize="19"
                FontAttributes="Bold"
                TextColor="#E4F0E5"
                Margin="0,4,0,0" />

            <!-- Температура -->
            <Border BackgroundColor="#1B261E" Stroke="#2C3B30"
                    StrokeShape="RoundRectangle 10" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Температура воздуха" FontSize="13"
                           TextColor="#A9B9AA" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="24 °C" FontSize="17"
                           FontAttributes="Bold" TextColor="#E4F0E5" />
                </Grid>
            </Border>

            <!-- Влажность воздуха -->
            <Border BackgroundColor="#1B261E" Stroke="#2C3B30"
                    StrokeShape="RoundRectangle 10" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Влажность воздуха" FontSize="13"
                           TextColor="#A9B9AA" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="58 %" FontSize="17"
                           FontAttributes="Bold" TextColor="#E4F0E5" />
                </Grid>
            </Border>

            <!-- Влажность почвы -->
            <Border BackgroundColor="#1B261E" Stroke="#2C3B30"
                    StrokeShape="RoundRectangle 10" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Влажность почвы" FontSize="13"
                           TextColor="#A9B9AA" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="42 %" FontSize="17"
                           FontAttributes="Bold" TextColor="#E4F0E5" />
                </Grid>
            </Border>

            <!-- Уровень воды -->
            <Border BackgroundColor="#1B261E" Stroke="#2C3B30"
                    StrokeShape="RoundRectangle 10" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Уровень воды" FontSize="13"
                           TextColor="#A9B9AA" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="75 %" FontSize="17"
                           FontAttributes="Bold" TextColor="#E4F0E5" />
                </Grid>
            </Border>

            <Label
                Text="Полив"
                FontSize="19"
                FontAttributes="Bold"
                TextColor="#E4F0E5"
                Margin="0,4,0,0" />

            <Border
                BackgroundColor="#1B261E"
                Stroke="#2C3B30"
                StrokeShape="RoundRectangle 10"
                Padding="12">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Насос выключен"
                        FontSize="13"
                        TextColor="#A9B9AA"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="CounterBtn"
                        Text="Включить полив"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        BackgroundColor="#347A46"
                        CornerRadius="10"
                        HeightRequest="44"
                        Clicked="OnCounterClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
